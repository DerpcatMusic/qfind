# Maintainer: Derpcat <https://github.com/DerpcatMusic>
pkgname=qfind-bin
pkgver=0.1.2
pkgrel=1
pkgdesc="Instant filename search (prebuilt CLI and TUI, x86_64)"
arch=('x86_64')
url="https://github.com/DerpcatMusic/qfind"
license=('MIT')
depends=('gcc-libs' 'glibc')
optdepends=(
  'qfind-gtk: GTK interface'
  'ripdrag: drag from the TUI'
)
provides=('qfind')
conflicts=('qfind')
options=('!strip')
source=("qfind-$pkgver-x86_64.tar.zst::https://github.com/DerpcatMusic/qfind/releases/download/v$pkgver/qfind-$pkgver-x86_64.tar.zst")
sha256sums=('8bfed7c47e0e7bb36c4fd6d1d30296499ff18917396c6bd7037e995447d93ce2')

package() {
  cd "$srcdir"
  install -Dm755 qfind qfind-tui -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

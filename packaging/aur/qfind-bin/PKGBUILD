# Maintainer: Derpcat <https://github.com/DerpcatMusic>
pkgname=qfind-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Instant filename search (prebuilt CLI and TUI, x86_64)"
arch=('x86_64')
url="https://github.com/DerpcatMusic/qfind"
license=('MIT')
depends=('gcc-libs' 'glibc')
optdepends=('qfind-gtk: GTK interface')
provides=('qfind')
conflicts=('qfind')
options=('!strip')
source=("qfind-$pkgver-x86_64.tar.zst::https://github.com/DerpcatMusic/qfind/releases/download/v$pkgver/qfind-$pkgver-x86_64.tar.zst")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -Dm755 qfind qfind-tui -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# Maintainer: Derpcat <https://github.com/DerpcatMusic>
pkgname=qfind
pkgver=0.1.2
pkgrel=1
pkgdesc="Instant filename search (CLI and TUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/DerpcatMusic/qfind"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=(
  'qfind-gtk: GTK interface'
  'ripdrag: drag from the TUI'
)
conflicts=('qfind-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/DerpcatMusic/qfind/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('48071c46a114b4593b089ffc42308353b9b355f5ac49195a157b67172807dbc8')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p qfind -p qfind-tui
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/qfind target/release/qfind-tui \
    -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

<Window x:Class="Qfind.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Qfind.Windows" Title="Qfind">
  <NavigationView x:Name="Places" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="PlaceChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Home" Icon="Home" Tag="Home"/>
      <NavigationViewItem Content="Desktop" Icon="AllApps" Tag="Desktop"/>
      <NavigationViewItem Content="Documents" Icon="Document" Tag="Documents"/>
      <NavigationViewItem Content="Downloads" Icon="Download" Tag="Downloads"/>
      <NavigationViewItem Content="Pictures" Icon="Pictures" Tag="Pictures"/>
      <NavigationViewItem Content="Music" Icon="MusicInfo" Tag="Music"/>
      <NavigationViewItem Content="Videos" Icon="Video" Tag="Videos"/>
    </NavigationView.MenuItems>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
        <AppBarButton Icon="Back" Click="BackClicked"/>
        <AppBarButton Icon="Forward" Click="ForwardClicked"/>
        <AppBarSeparator/>
        <AppBarToggleButton x:Name="Recursive" Label="Qfind" Icon="Find" Click="RefreshClicked"/>
        <AppBarToggleButton x:Name="ListMode" Label="List" Icon="List" Click="ViewClicked"/>
        <AppBarToggleButton x:Name="ChartButton" Label="Chart" Icon="View" Click="ChartClicked"/>
        <AppBarToggleButton x:Name="GlobalChart" Label="Global" Icon="World" Click="GlobalChartClicked"/>
        <CommandBar.Content>
          <AutoSuggestBox x:Name="Search" Width="420" PlaceholderText="Find in this folder" TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted"/>
        </CommandBar.Content>
      </CommandBar>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="RightColumn" Width="380"/></Grid.ColumnDefinitions>
        <GridView x:Name="Files" IsItemClickEnabled="True" ItemClick="FileClicked" DoubleTapped="FileDoubleTapped" SelectionMode="Single">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate><ItemsWrapGrid x:Name="Wrap" Orientation="Horizontal" MaximumRowsOrColumns="0"/></ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemTemplate>
            <DataTemplate>
              <Grid Width="148" Height="150" Padding="8">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="{Binding Size}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" HorizontalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>
        <ListView x:Name="FileList" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="FileClicked" DoubleTapped="FileDoubleTapped" SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Height="44" Padding="8,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Size}" Opacity="0.65" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <Thumb Grid.Column="1" DragDelta="PreviewDividerDragged" Background="Transparent"/>
        <Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16">
          <Image x:Name="PreviewImage" Stretch="Uniform"/>
          <ScrollViewer><TextBlock x:Name="PreviewText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
          <Canvas x:Name="ChartCanvas" SizeChanged="ChartSizeChanged" Visibility="Collapsed"/>
        </Grid>
      </Grid>
      <Grid Grid.Row="2" Padding="12,6" Background="{ThemeResource LayerFillColorAltBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Location" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="84" Maximum="240" Value="148" Header="Tile size" ValueChanged="DensityChanged"/>
      </Grid>
    </Grid>
  </NavigationView>
</Window>
